# Copy to .env and adjust.

# --- Database -------------------------------------------------------------
# Defaults to a local SQLite file so the prototype runs with zero setup.
# For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg2://lectureloop:password@localhost:5432/lectureloop
DATABASE_URL=sqlite:///./lectureloop.db

# --- Security -------------------------------------------------------------
# CHANGE THIS in any non-local deployment.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- AI generation --------------------------------------------------------
# Leave LLM_API_KEY empty to use the built-in deterministic offline generator.
# Set it to use any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Processing -----------------------------------------------------------
# Max characters of transcript sent per LLM call.
MAX_SEGMENT_CHARS=6000
# Enable/disable fetching captions from YouTube (respects terms; best-effort).
ENABLE_YOUTUBE_CAPTIONS=true
